# ============================================================================
# CANDY OR CURSE? — Environment Variables (.env.example)
# Copy this file to `backend/.env` (for FastAPI) and `frontend/.env` (for Vite)
# NEVER commit real API keys to Git!
# ============================================================================

# --- BACKEND CONFIGURATION (Team B) ---
# Google AI Studio / Gemini API Key for Gemma 4 Vision & Chat
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# Supported Gemma 4 multimodal instruction-tuned models:
# - gemma-4-26b-a4b-it (Fast MoE multimodal - Recommended for Hackathon MVP)
# - gemma-4-31b-it     (Dense 31B multimodal)
GEMMA_MODEL=gemma-4-26b-a4b-it

# ElevenLabs API Configuration (Server-side only)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Spooky Voice ID for "The Candy Keeper" (Default: George / JBFqnCBsd6RMkjVDRZzb or custom spooky voice)
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v1

# Server & CORS Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Public HTTPS URL used for generating mobile QR codes (e.g. ngrok / Cloudflare Tunnel / Lovable URL)
PUBLIC_FRONTEND_URL=https://your-lovable-or-tunnel-url.lovable.app
CORS_ORIGINS=*

# --- FRONTEND CONFIGURATION (Team A / Lovable) ---
# Set VITE_USE_MOCK_API=true to develop independently with mock responses before Team B's backend is live
VITE_USE_MOCK_API=true
# Point to Team B's public HTTPS tunnel or deployed FastAPI URL when ready
VITE_API_BASE_URL=http://localhost:8000
# Optional override for QR Code target URL (must be HTTPS so mobile camera works!)
VITE_PUBLIC_APP_URL=https://your-lovable-or-tunnel-url.lovable.app
